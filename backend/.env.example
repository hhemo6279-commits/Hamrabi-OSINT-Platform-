# Hamrabi backend configuration
# Copy to .env (or set in your shell) for production use.

# Strong random secret for JWT signing. Generate: python -c "import secrets; print(secrets.token_hex(32))"
HAMRABI_SECRET_KEY=change-me-to-a-long-random-string
HAMRABI_JWT_ALG=HS256
HAMRABI_TOKEN_TTL_MIN=720

# Comma-separated allowed CORS origins (no spaces). e.g. https://hamrabi.example.com
HAMRABI_CORS_ORIGINS=*

# AI provider: openai | anthropic | none
HAMRABI_AI_PROVIDER=none
HAMRABI_AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=